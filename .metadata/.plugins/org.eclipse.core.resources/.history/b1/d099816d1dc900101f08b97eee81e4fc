<!-- Products Section -->
<section class="products-section">
  <h2 class="section-title">Today's Discount</h2>
  <div class="products-grid">
    <c:forEach var="product" items="${products}">
      <div class="product-card">
        <div class="bookmark-icon">🔖</div>
        <div class="product-image">${product.image}</div>
        <div class="product-brand">${product.brand}</div>
        <div class="product-name">${product.name}</div>
        <div class="product-price">
          <span class="original">${product.originalPrice}$</span>
          <span class="discount">${product.price}$</span>
        </div>
      </div>
    </c:forEach>
  </div>
</section>
<script>
    // 페이지가 로드된 후 실행
    window.addEventListener('load', function() {
        const inputEn = document.getElementById('input-muscle-en');
        const inputKr = document.getElementById('input-muscle-kr');
        
        // class="muscle-obj"를 가진 모든 object 태그 선택
        const svgObjects = document.querySelectorAll('.muscle-obj');

        svgObjects.forEach(obj => {
            // object 내부 문서 접근
            // 주의: 로컬 파일(file://) 실행 시 크롬 보안 정책으로 인해 작동 안 할 수 있음. 서버(localhost) 구동 필수.
            const svgDoc = obj.contentDocument; 
            
            if (svgDoc) {
                // SVG 내부의 클릭 가능한 그룹(.muscle) 선택
                const muscles = svgDoc.querySelectorAll('.muscle');

                muscles.forEach(muscle => {
                    // 호버 효과 (CSS가 안 먹힐 경우 JS로 보조)
                    muscle.style.cursor = 'pointer';

                    // 클릭 이벤트
                    muscle.addEventListener('click', function() {
                        // data 속성 가져오기
                        const enName = this.dataset.valueE; // data-value-e
                        const krName = this.dataset.valueK; // data-value-k

                        // input 값 업데이트
                        if(inputEn) inputEn.value = enName;
                        if(inputKr) inputKr.value = krName;

                    });
                });
            }
        });
    });
</script>
